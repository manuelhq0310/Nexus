# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completa los valores. ".env" NO debe subirse al repositorio (ya está en
# .gitignore) porque contiene secretos.

# --- Base de datos ---
POSTGRES_DB=NexusDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- JWT ---
# Genera una cadena aleatoria de al menos 32 caracteres, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTA_LLAVE_POR_UNA_SECRETA_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=Nexus.Api
JWT_AUDIENCE=Nexus.Clients
JWT_EXPIRY_MINUTES=60

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production
RUN_MIGRATIONS_ON_STARTUP=true

# --- Frontend ---
# URL con la que el NAVEGADOR alcanza al backend. En local con los puertos
# por defecto de este docker-compose.yml es http://localhost:5100.
# En un despliegue real, usa la URL pública de tu API (ej. https://api.tudominio.com).
API_BASE_URL=http://localhost:5100
