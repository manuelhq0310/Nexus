# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completa los valores. ".env" NO debe subirse al repositorio (ya está en
# .gitignore) porque contiene secretos.

# --- Base de datos (PostgreSQL en la nube) ---
# Cadena de conexión completa al formato de Npgsql. Ejemplos según el proveedor:
#
#   Genérico:
#     Host=<host>;Port=5432;Database=NexusDB;Username=<usuario>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
#
#   Azure Database for PostgreSQL:
#     Host=mi-servidor.postgres.database.azure.com;Port=5432;Database=NexusDB;Username=miusuario;Password=miclave;SSL Mode=Require
#
#   AWS RDS:
#     Host=mi-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com;Port=5432;Database=NexusDB;Username=miusuario;Password=miclave;SSL Mode=Require;Trust Server Certificate=true
#
#   Supabase (usar el "Connection pooling" host si tu proveedor de hosting no soporta IPv6):
#     Host=aws-0-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xxxxxxxxxxxx;Password=miclave;SSL Mode=Require
#
#   Neon:
#     Host=ep-xxxx-xxxx.us-east-2.aws.neon.tech;Port=5432;Database=NexusDB;Username=miusuario;Password=miclave;SSL Mode=Require
#
# La mayoría de proveedores administrados EXIGEN SSL; si omites "SSL Mode=Require" la
# conexión probablemente falle. Ajusta host/puerto/usuario/password/nombre de BD según
# los datos que te dio tu proveedor.
NEXUS_DB_CONNECTION_STRING=Host=TU_HOST;Port=5432;Database=NexusDB;Username=TU_USUARIO;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# --- JWT ---
# Genera una cadena aleatoria de al menos 32 caracteres, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTA_LLAVE_POR_UNA_SECRETA_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=Nexus.Api
JWT_AUDIENCE=Nexus.Clients
JWT_EXPIRY_MINUTES=60

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production
RUN_MIGRATIONS_ON_STARTUP=true

# --- Frontend ---
# URL con la que el NAVEGADOR alcanza al backend. En local con los puertos
# por defecto de este docker-compose.yml es http://localhost:5100.
# En un despliegue real, usa la URL pública/alcanzable de tu API.
#
# ⚠️ Errores comunes que causan una pantalla en blanco con "UriFormatException"
# o "net_uri_BadFormat" en la consola del navegador:
#   ❌ API_BASE_URL=nexus_api                     (falta esquema http/https)
#   ❌ API_BASE_URL=nexus.api                     (nombre interno de Docker Compose;
#                                                   el navegador no puede resolverlo,
#                                                   solo lo resuelven los contenedores
#                                                   entre sí)
#   ✅ API_BASE_URL=http://localhost:5100         (local)
#   ✅ API_BASE_URL=http://TU_IP_O_DOMINIO:PUERTO (servidor remoto, con el puerto
#                                                   publicado/mapeado del servicio
#                                                   nexus.api, ej. http://172.30.2.203:32789)
#   ✅ API_BASE_URL=https://api.tudominio.com     (producción, detrás de un dominio)
API_BASE_URL=http://localhost:5100
