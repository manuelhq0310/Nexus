@using Nexus.Presentation.Models
@using Nexus.Presentation.Services.Api

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Apps" Class="mr-2 mb-n1" />
            Editar aplicación
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <MudTextField T="string" Label="Código de aplicación" @bind-Value="_model.CodigoApp" For="@(() => _model.CodigoApp)" Variant="Variant.Outlined" Class="mb-3" Required="true" />
            <MudTextField T="string" Label="Nombre" @bind-Value="_model.Nombre" For="@(() => _model.Nombre)" Variant="Variant.Outlined" Class="mb-3" Required="true" />
            <MudTextField T="string" Label="Descripción" @bind-Value="_model.Descripcion" For="@(() => _model.Descripcion)" Variant="Variant.Outlined" Class="mb-2" Lines="3" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
            }

            <div class="d-flex justify-end mt-6 gap-2">
                <MudButton OnClick="Cancelar">Cancelar</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando">
                    @if (_guardando)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    Guardar
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public AplicacionDto Existente { get; set; } = default!;
    [Inject] private AplicacionApiService AplicacionApi { get; set; } = default!;

    private readonly ActualizarAplicacionDto _model = new();
    private bool _guardando;
    private string? _error;

    protected override void OnInitialized()
    {
        _model.CodigoApp = Existente.CodigoApp;
        _model.Nombre = Existente.Nombre;
        _model.Descripcion = Existente.Descripcion;
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _error = null;
        try
        {
            await AplicacionApi.ActualizarAsync(Existente.Id, _model);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
