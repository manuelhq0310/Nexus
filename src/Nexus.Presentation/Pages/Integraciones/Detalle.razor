@page "/integraciones/{Id:long}"
@attribute [Authorize]
@using Nexus.Presentation.Models
@using Nexus.Presentation.Services.Api
@inject IntegracionApiService IntegracionApi
@inject ConectorApiService ConectorApi
@inject UnoEConsultaApiService UnoEConsultaApi
@inject IntegracionConectorApiService IntegracionConectorApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Nexus - @(_integracion?.Nombre ?? "Integración")</PageTitle>

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/integraciones" Class="mb-4">
    Volver a Integraciones
</MudButton>

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_integracion is null)
{
    <MudAlert Severity="Severity.Error">No se encontró la integración solicitada.</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-6 mb-6">
        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
            <div class="d-flex align-center">
                <MudAvatar Color="Color.Secondary" Size="Size.Large" Class="mr-4">
                    <MudIcon Icon="@Icons.Material.Filled.SyncAlt" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5">@_integracion.Nombre</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_integracion.CodigoAccion</MudChip>
                        @if (_integracion.Tipo is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(_integracion.Tipo == TipoIntegracion.Consulta ? Color.Info : Color.Warning)">
                                @(_integracion.Tipo == TipoIntegracion.Consulta ? "Consulta" : "Escritura")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @(_integracion.EsAsincrono ? "Asíncrona" : "Síncrona")
                            </MudChip>
                        }
                        @_integracion.Descripcion
                    </MudText>
                </div>
            </div>
            <MudChip T="string" Color="@(_integracion.Estado ? Color.Success : Color.Default)">
                @(_integracion.Estado ? "Activa" : "Inactiva")
            </MudChip>
        </div>
    </MudPaper>

    <div class="d-flex align-center justify-space-between mb-3">
        <div>
            <MudText Typo="Typo.h6">Conectores habilitados</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Define aquí qué conectores pueden resolver esta integración y con qué endpoint/cola.
            </MudText>
        </div>
        @if (!_mostrarFormularioAgregar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _mostrarFormularioAgregar = true)">
                Habilitar conector
            </MudButton>
        }
    </div>

    @if (_mostrarFormularioAgregar)
    {
        <!-- ===================== Mismo formulario del paso 2 del asistente de creación ===================== -->
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            @if (_conectoresActivos.Count == 0)
            {
                <MudAlert Severity="Severity.Warning">
                    No hay conectores activos registrados. <MudLink Href="/conectores">Crea uno primero</MudLink>.
                </MudAlert>
            }
            else if (_conectoresDisponiblesParaAgregar.Any())
            {
                <IntegracionConectorCampos Model="_nuevoForm" Tipo="_integracion!.Tipo" EsAsincrono="_integracion!.EsAsincrono"
                                           Conectores="_conectoresDisponiblesParaAgregar" UnoEConsultas="_unoEConsultas" />
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    Ya habilitaste todos los conectores activos disponibles para esta integración.
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(_errorAgregar))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_errorAgregar</MudAlert>
            }

            <div class="d-flex justify-end gap-2 mt-3">
                <MudButton Variant="Variant.Text" OnClick="CerrarFormularioAgregar">
                    Listo
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_agregandoConector || !_conectoresDisponiblesParaAgregar.Any())" OnClick="AgregarConectorAsync">
                    @if (_agregandoConector)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    Agregar conector
                </MudButton>
            </div>
        </MudPaper>
    }

    <MudPaper Elevation="2" Class="pa-2">
        <MudTable Items="_conectoresHabilitados" Loading="_cargandoConectores" Hover="true">
            <HeaderContent>
                <MudTh>Conector</MudTh>
                <MudTh>Ruta del endpoint</MudTh>
                <MudTh>Cola RabbitMQ</MudTh>
                <MudTh>Consulta genérica</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="width:100px;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Conector">@context.NombreConector</MudTd>
                <MudTd DataLabel="Ruta">
                    @if (string.IsNullOrWhiteSpace(context.RutaEndpoint)) { <span>—</span> } else { <code>@context.RutaEndpoint</code> }
                </MudTd>
                <MudTd DataLabel="Cola">@(string.IsNullOrWhiteSpace(context.ColaRabbitMQDestino) ? "—" : context.ColaRabbitMQDestino)</MudTd>
                <MudTd DataLabel="Consulta genérica">
                    @if (context.EsConsultaGenerica)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">
                            @(NombreConsultaUnoE(context.UnoEConsultaConfigId))
                        </MudChip>
                    }
                    else { <span>—</span> }
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Estado ? Color.Success : Color.Default)">
                        @(context.Estado ? "Activo" : "Inactivo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => AbrirEditarConectorAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.Estado ? "Desactivar" : "Activar")">
                        <MudIconButton Icon="@(context.Estado ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                       Color="@(context.Estado ? Color.Success : Color.Default)"
                                       Size="Size.Small" OnClick="@(() => CambiarEstadoConectorAsync(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">
                    Todavía no hay conectores habilitados para esta integración.
                    Sin al menos uno activo, ninguna empresa podrá usar esta integración.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private IntegracionDto? _integracion;
    private List<IntegracionConectorDto> _conectoresHabilitados = new();
    private List<ConectorDto> _conectoresActivos = new();
    private bool _cargando = true;
    private bool _cargandoConectores = true;

    // Panel inline para habilitar conectores (mismo formulario que el paso 2 del asistente de creación)
    private bool _mostrarFormularioAgregar;
    private readonly IntegracionConectorFormModel _nuevoForm = new();
    private List<UnoEConsultaConfigDto> _unoEConsultas = new();
    private bool _agregandoConector;
    private string? _errorAgregar;

    private IEnumerable<ConectorDto> _conectoresDisponiblesParaAgregar =>
        _conectoresActivos.Where(c => _conectoresHabilitados.All(h => h.ConectorId != c.Id));

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _cargandoConectores = true;
        try
        {
            _integracion = await IntegracionApi.ObtenerPorIdAsync(Id);
            _conectoresHabilitados = await IntegracionConectorApi.ObtenerPorIntegracionAsync(Id);
            _conectoresActivos = await ConectorApi.ObtenerTodosAsync(soloActivos: true);
            _unoEConsultas = await UnoEConsultaApi.ObtenerTodasAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargando = false;
            _cargandoConectores = false;
        }
    }

    private string NombreConsultaUnoE(long? id) =>
        _unoEConsultas.FirstOrDefault(c => c.Id == id)?.CodigoConsulta ?? "Genérica";

    private async Task AgregarConectorAsync()
    {
        _errorAgregar = _nuevoForm.Validar(_integracion!.Tipo, _integracion.EsAsincrono, requiereConector: true);
        if (_errorAgregar is not null)
        {
            return;
        }

        _agregandoConector = true;
        try
        {
            var nuevaRelacion = await IntegracionConectorApi.CrearAsync(_nuevoForm.ACrear(Id, _integracion.Tipo));

            _conectoresHabilitados.Add(nuevaRelacion);
            _nuevoForm.Limpiar();
            Snackbar.Add("Conector habilitado correctamente.", Severity.Success);
        }
        catch (ApiException ex)
        {
            _errorAgregar = ex.Message;
        }
        finally
        {
            _agregandoConector = false;
        }
    }

    private void CerrarFormularioAgregar()
    {
        _mostrarFormularioAgregar = false;
        _nuevoForm.Limpiar();
        _errorAgregar = null;
    }

    private async Task AbrirEditarConectorAsync(IntegracionConectorDto relacion)
    {
        var parameters = new DialogParameters<IntegracionConectorFormDialog>
        {
            { x => x.IntegracionId, Id },
            { x => x.Tipo, _integracion?.Tipo },
            { x => x.EsAsincrono, _integracion?.EsAsincrono ?? false },
            { x => x.UnoEConsultas, _unoEConsultas },
            { x => x.Existente, relacion }
        };
        var dialog = await DialogService.ShowAsync<IntegracionConectorFormDialog>("Editar conector habilitado", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Configuración actualizada correctamente.", Severity.Success);
            await CargarAsync();
        }
    }

    private async Task CambiarEstadoConectorAsync(IntegracionConectorDto relacion)
    {
        try
        {
            await IntegracionConectorApi.CambiarEstadoAsync(relacion.Id, !relacion.Estado);
            Snackbar.Add("Estado actualizado.", Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
