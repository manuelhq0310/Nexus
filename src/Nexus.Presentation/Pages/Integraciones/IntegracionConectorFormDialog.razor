@using Nexus.Presentation.Models
@using Nexus.Presentation.Services.Api

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Class="mr-2 mb-n1" />
            @(EsEdicion ? "Editar conector habilitado" : "Habilitar conector para esta integración")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="min-width:460px;" Class="pa-0">
            @if (EsEdicion)
            {
                <MudTextField T="string" Label="Conector" Value="@Existente!.NombreConector" ReadOnly="true" Variant="Variant.Outlined" Class="mb-3" />
            }
            else if (ConectoresDisponibles.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                    No hay conectores activos disponibles. <MudLink Href="/conectores">Crea uno primero</MudLink>.
                </MudAlert>
            }

            <IntegracionConectorCampos Model="_model" Tipo="Tipo" EsAsincrono="EsAsincrono"
                                       Conectores="@(EsEdicion ? null : ConectoresDisponibles)"
                                       UnoEConsultas="UnoEConsultas" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
            }

            <div class="d-flex justify-end mt-6 gap-2">
                <MudButton OnClick="Cancelar">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando" OnClick="GuardarAsync">
                    @if (_guardando)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    Guardar
                </MudButton>
            </div>
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public long IntegracionId { get; set; }
    [Parameter] public TipoIntegracion? Tipo { get; set; }
    [Parameter] public bool EsAsincrono { get; set; }
    [Parameter] public IntegracionConectorDto? Existente { get; set; }
    [Parameter] public List<ConectorDto> ConectoresDisponibles { get; set; } = new();
    [Parameter] public List<UnoEConsultaConfigDto> UnoEConsultas { get; set; } = new();
    [Inject] private IntegracionConectorApiService IntegracionConectorApi { get; set; } = default!;

    private bool EsEdicion => Existente is not null;
    private IntegracionConectorFormModel _model = new();
    private bool _guardando;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Existente is not null)
        {
            _model = IntegracionConectorFormModel.Desde(Existente);
        }
    }

    private async Task GuardarAsync()
    {
        _error = _model.Validar(Tipo, EsAsincrono, requiereConector: !EsEdicion);
        if (_error is not null) return;

        _guardando = true;
        try
        {
            if (EsEdicion)
                await IntegracionConectorApi.ActualizarAsync(Existente!.Id, _model.AActualizar(Tipo));
            else
                await IntegracionConectorApi.CrearAsync(_model.ACrear(IntegracionId, Tipo));

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = $"Error inesperado: {ex.Message}"; }
        finally { _guardando = false; }
    }

    private void Cancelar() => MudDialog.Cancel();
}
